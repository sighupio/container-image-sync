# Copa uses the helper's apt to download packages for the target image, running `apt-get download pkg`
# without a version and accepting any version greater or equal to the one requested by Trivy.
# The helper must therefore have the apt sources of the target image's Debian release only.
# Build one helper per Debian release (DEBIAN_RELEASE=bookworm, trixie, ...), see MAINTENANCE.md.
ARG DEBIAN_RELEASE
FROM debian:${DEBIAN_RELEASE}-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends debconf perl libterm-readline-perl-perl \
    && rm -rf /var/lib/apt/lists/*
